{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grafana datasource provisioning",
  "type": "object",
  "additionalProperties": true,
  "required": ["apiVersion", "datasources"],
  "properties": {
    "apiVersion": {
      "type": "integer",
      "enum": [1]
    },
    "datasources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "type", "access"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "access": { "type": "string" },
          "url": { "type": "string" },
          "isDefault": { "type": "boolean" },
          "editable": { "type": "boolean" }
        }
      }
    }
  }
}
