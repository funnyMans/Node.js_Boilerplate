{
  "name": "users-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "pnpm exec prisma generate",
    "dev": "tsx watch src/server.ts",
    "prestart": "pnpm exec prisma generate",
    "start": "node dist/src/server.js",
    "prebuild": "pnpm run clean && pnpm exec prisma generate",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate": "pnpm exec prisma migrate dev"
  },
  "dependencies": {
    "@app/common": "workspace:*",
    "@app/contracts": "workspace:*",
    "@nodejs-boilerplate/common-infra": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
