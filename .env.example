# Local development values only. Never use these defaults on a server.
# Copy this file to .env; .env is ignored by Git.
DATABASE_URL="postgresql://dev:dev@127.0.0.1:5432/app"
REDIS_URL="redis://127.0.0.1:6379"
NATS_URL="nats://127.0.0.1:4222"
TEMPORAL_ADDRESS="127.0.0.1:7233"
ORDERS_SERVICE_URL="http://127.0.0.1:3003"
PAYMENTS_SERVICE_URL="http://127.0.0.1:3010"
INVENTORY_SERVICE_URL="http://127.0.0.1:3011"
TEMPORAL_TASK_QUEUE="orders-fulfillment"
SERVICE_TO_SERVICE_TOKEN="local-development-service-token-please-change-32"
AUTH_TOKEN_SECRET="local-development-auth-token-secret-change-me-32"
STRIPE_SECRET_KEY="sk_test_replace_with_a_real_test_key"
PAYMENTS_FAKE_STRIPE=false
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOCAL_S3_ACCESS_KEY_ID=minioadmin
LOCAL_S3_SECRET_ACCESS_KEY=minioadmin
OUTBOX_RETENTION_DAYS=0

