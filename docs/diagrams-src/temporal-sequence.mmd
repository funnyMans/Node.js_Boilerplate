sequenceDiagram
  participant Dispatcher as Orders Workflow Dispatcher
  participant DB as Orders PostgreSQL
  participant T as Temporal
  participant W as Orders Temporal Worker
  participant P as Payments HTTP Service
  participant I as Inventory HTTP Service

  Dispatcher->>DB: claim NATS-published workflow-pending row
  Dispatcher->>T: start deterministic workflow ID
  T->>W: schedule workflow task
  W->>P: charge payment with idempotency key
  P-->>W: payment result
  alt payment declined
    W->>DB: cancel order
  else payment succeeded
    W->>I: reserve inventory with idempotency key
    I-->>W: reservation result
    alt inventory reserved
      W->>DB: confirm order
    else inventory unavailable
      W->>P: refund with idempotency key
      P-->>W: refund result
      W->>DB: cancel order after refund succeeds
    end
  end
