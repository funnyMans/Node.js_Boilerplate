{
  "name": "trucking-tms-study",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:all": "pnpm -w -r exec tsc -b",
    "start:all": "pnpm -w -r --parallel start",
    "dev:all": "pnpm -w -r --parallel --filter './services/*' dev",
    "lint": "eslint './**/*.{ts,js,tsx,jsx}' --max-warnings 0",
    "format": "prettier --write './**/*.{ts,js,json,md,tsx,jsx}'",
    "test": "pnpm run test:unit",
    "test:all": "vitest run",
    "test:unit": "vitest run --exclude '**/tests/integration/**' --exclude '**/tests/e2e/**'",
    "test:integration": "vitest run services/users/tests/integration",
    "prepare": "husky",
    "docker:up": "docker compose -f infra/docker-compose.dev.yml up -d --no-build",
    "docker:down": "docker compose -f infra/docker-compose.dev.yml down --remove-orphans",
    "docker:logs": "docker compose -f infra/docker-compose.dev.yml logs -f --tail=200",
    "docker:status": "docker compose -f infra/docker-compose.dev.yml ps --all",
    "docker:health": "curl -fsS http://localhost:8080/health && echo && curl -fsS http://localhost:3000/ready && echo",
    "docker:service-contract": "node scripts/service-contract-check.mjs",
    "docker:migrate:users": "docker compose -f infra/docker-compose.dev.yml exec -T users pnpm exec prisma migrate deploy --schema=services/users/prisma/schema.prisma",
    "docker:migrate:auth": "docker compose -f infra/docker-compose.dev.yml exec -T auth-service sh -c 'cd services/auth-service && pnpm exec prisma migrate deploy'",
    "docker:rebuild": "docker compose -f infra/docker-compose.dev.yml build --no-cache"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
