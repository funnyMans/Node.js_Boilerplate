{
  "name": "nodejs-infra-boilerplate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:all": "pnpm -w -r exec tsc -b",
    "start:all": "pnpm -w -r --parallel start",
    "dev:all": "pnpm -w -r --parallel --filter './services/*' dev",
    "lint": "eslint './**/*.{ts,js,tsx,jsx}' --max-warnings 0",
    "format": "prettier --write './**/*.{ts,js,json,md,tsx,jsx}'",
    "test": "pnpm run test:unit",
    "test:all": "vitest run",
    "test:unit": "vitest run --exclude '**/tests/integration/**' --exclude '**/tests/e2e/**'",
    "test:integration": "vitest run tests/integration",
    "prepare": "husky",
    "db:generate": "pnpm -w -r run prisma:generate",
    "db:migrate": "pnpm -w -r run prisma:migrate",
    "db:deploy": "pnpm -w -r run prisma:deploy",
    "docker:up": "docker compose -f infra/docker-compose.dev.yml up -d --no-build",
    "docker:down": "docker compose -f infra/docker-compose.dev.yml down --remove-orphans",
    "docker:logs": "docker compose -f infra/docker-compose.dev.yml logs -f --tail=200",
    "docker:status": "docker compose -f infra/docker-compose.dev.yml ps --all",
    "docker:health": "curl -fsS http://localhost:8080/health && echo && curl -fsS http://localhost:3001/health && echo",
    "docker:e2e-up": "docker compose -f infra/docker-compose.dev.yml -f infra/docker-compose.e2e.yml up -d --no-build --wait api-gateway",
    "docker:e2e-seed": "docker compose -f infra/docker-compose.dev.yml -f infra/docker-compose.e2e.yml run --rm --no-deps s3-mock-init",
    "docker:order-journey": "E2E_ORDER_JOURNEY=1 pnpm exec vitest run services/orders/tests/e2e/order-journey.e2e.test.ts",
    "docker:service-contract": "node scripts/service-contract-check.mjs",
    "docker:migrate": "docker compose -f infra/docker-compose.dev.yml exec -T users pnpm exec prisma migrate deploy --schema=services/users/prisma/schema.prisma",
    "etl:test": "cd services/etl && python3 -m unittest discover -s tests",
    "docker:reset": "docker compose -f infra/docker-compose.dev.yml down -v --remove-orphans || true",
    "docker:rebuild": "docker compose -f infra/docker-compose.dev.yml build --no-cache"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.4",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@temporalio/worker": "^1.23.0",
    "nats": "^2.29.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  }
}
